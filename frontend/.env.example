NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_STORAGE_URL=http://localhost:8000/storage
NEXT_PUBLIC_REVERB_APP_KEY=
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http

# Real Laravel data, with the Sanctum token kept in a server-only HttpOnly cookie.
# Use AUTH_MODE=mock only for an isolated frontend demonstration.
AUTH_MODE=api
AUTH_API_URL=http://localhost:8000/api
AUTH_APP_URL=http://localhost:3000
